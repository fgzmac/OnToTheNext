generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DestinationScope {
  CITY_BASE
  COUNTRY_REGION
}

model PrototypeUser {
  id          String   @id @default(cuid())
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       Trip[]
}

model Trip {
  id                String                 @id @default(cuid())
  ownerId           String
  name              String?
  destinationLabel  String
  destinationScope  DestinationScope
  startDate         DateTime               @db.Date
  endDate           DateTime               @db.Date
  travelerCount     Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  owner             PrototypeUser          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  segments          TripSegment[]
  days              Day[]
  recommendations   Recommendation[]
  itineraryItems    ItineraryItem[]
  manualActivitySubmissions ManualActivitySubmission[]
  travelPlans       ItineraryTravelPlan[]
  reservations      Reservation[]
  preferenceProfile TripPreferenceProfile?
  researchJobs ResearchJob[]

  @@index([ownerId])
}

model TripSegment {
  id            String   @id @default(cuid())
  tripId        String
  baseName      String
  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date
  position      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  primaryDays   Day[]    @relation("PrimarySegmentDays")
  recommendations Recommendation[]
  outgoingItems ItineraryItem[] @relation("TransportationOrigin")
  incomingItems ItineraryItem[] @relation("TransportationDestination")

  @@unique([id, tripId])

  @@unique([tripId, position])
  @@index([tripId, arrivalDate, departureDate])
}

model Day {
  id               String       @id @default(cuid())
  tripId           String
  date             DateTime     @db.Date
  primarySegmentId String?
  position         Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  trip             Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  primarySegment   TripSegment? @relation("PrimarySegmentDays", fields: [primarySegmentId], references: [id], onDelete: SetNull)

  itineraryItems   ItineraryItem[]

  @@unique([id, tripId])
  @@unique([tripId, date])
  @@unique([tripId, position])
  @@index([primarySegmentId])
}

model TripPreferenceProfile {
  id            String   @id @default(cuid())
  tripId        String   @unique
  discoverInterests DiscoverInterest[] @default([])
  budgetComfort String?
  planningNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
enum DiscoverInterest {
  SIGHTSEEING_LANDMARKS
  ARCHITECTURE_DESIGN
  CULTURE_HISTORY
  FOOD_DRINK
  SHOPPING
  NATURE_OUTDOORS
  NIGHTLIFE
  ENTERTAINMENT
  WELLNESS_RELAXATION
}

enum RecommendationOutcome {
  ACCEPTED
  DENIED
  SAVED
  MUST_DO
}

model Place {
  research ResearchPlace?
  id              String           @id @default(cuid())
  name            String
  baseLabel       String
  interestTags    DiscoverInterest[] @default([])
  category        String
  address         String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recommendations Recommendation[]
  evidence        EvidenceRecord[]
}

model Recommendation {
  id              String                  @id @default(cuid())
  tripId          String
  tripSegmentId   String
  placeId         String
  factualSummary  String
  durationMinutes Int?
  costContext     String?
  logisticsNote   String?
  presentationBatch Int?
  presentationOrder Int?
  displayRank     Int
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  trip            Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripSegment     TripSegment             @relation(fields: [tripSegmentId, tripId], references: [id, tripId], onDelete: Cascade)
  place           Place                   @relation(fields: [placeId], references: [id], onDelete: Restrict)
  scheduledItem   ItineraryItem?
  decision        RecommendationDecision?

  @@unique([tripSegmentId, presentationBatch, presentationOrder])
  @@unique([tripSegmentId, placeId])
  @@index([tripId, tripSegmentId, displayRank, id])
}

model RecommendationDecision {
  id               String                @id @default(cuid())
  recommendationId String                @unique
  outcome          RecommendationOutcome
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  recommendation   Recommendation        @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

model Source {
  id        String           @id @default(cuid())
  name      String
  kind      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  evidence  EvidenceRecord[]
}

model EvidenceRecord {
  sourceUrl String?
  locator String?
  permissionBasis String?
  id          String   @id @default(cuid())
  sourceId    String
  placeId     String?
  topic       String
  factualText String
  retrievedAt DateTime
  status      String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  place       Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)

  releaseObservation ReleaseObservation?
  reservationLinks ReservationEvidence[]

  @@unique([placeId, sourceId, topic])
  @@index([sourceId])
}

enum ItineraryItemType {
  ACTIVITY
  MEAL
  SHOPPING
  TRANSPORTATION
  FREE_TIME
  HOTEL_REST
  CUSTOM
}

enum ItineraryFlexibility {
  FIXED
  FLEXIBLE
}

enum TransportationMode {
  TRAIN
  FLIGHT
  BUS
  CAR
  TRANSIT
  WALK
  FERRY
  OTHER
}

enum ItineraryProgress {
  PENDING
  COMPLETED
  SKIPPED
}

model ItineraryItem {
  enteredManually Boolean @default(false)
  locationLabel String?
  referenceUrl String?
  editActionKey String?
  editResultContext String?
  manualSubmission ManualActivitySubmission?
  travelPlanActionKey     String?
  travelPlan              ItineraryTravelPlan? @relation("TravelTarget")
  departurePlansFromHere  ItineraryTravelPlan[] @relation("TravelOrigin")
  progress               ItineraryProgress @default(PENDING)
  progressChangedAt      DateTime? @db.Timestamptz(3)
  progressActionKey      String?
  id                     String @id @default(cuid())
  tripId                 String
  dayId                  String
  type                   ItineraryItemType
  title                  String
  startMinute            Int?
  durationMinutes        Int?
  position               Int
  flexibility            ItineraryFlexibility @default(FLEXIBLE)
  notes                  String?
  sourceRecommendationId String? @unique
  transportationMode     TransportationMode?
  originSegmentId        String?
  destinationSegmentId   String?
  revision               Int @default(0)
  originSegment          TripSegment? @relation("TransportationOrigin", fields: [originSegmentId], references: [id], onDelete: SetNull)
  destinationSegment     TripSegment? @relation("TransportationDestination", fields: [destinationSegmentId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  trip                   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day                    Day @relation(fields: [dayId, tripId], references: [id, tripId], onDelete: NoAction)
  sourceRecommendation   Recommendation? @relation(fields: [sourceRecommendationId], references: [id], onDelete: SetNull)

  reservation Reservation?

  @@index([originSegmentId])
  @@index([destinationSegmentId])
  @@unique([id, tripId])
  @@unique([dayId, position])
  @@index([tripId])
}

enum ReservationType {
  ACTIVITY
  HOTEL
  TRANSPORTATION
}
enum ReservationState {
  BOOK_NOW
  OPENS_LATER
  CHECK_BACK
  OPTIONAL
  NO_RESERVATION_NEEDED
  BOOKED
  NEEDS_ATTENTION
  CANCELLED
}
model Reservation {
  title String @default("Unlinked activity reservation")
  revision Int @default(0)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancellationNote String?
  id String @id @default(cuid())
  tripId String
  type ReservationType
  state ReservationState
  itineraryItemId String? @unique
  desiredDate DateTime? @db.Date
  desiredStartMinute Int?
  confirmedDate DateTime? @db.Date
  confirmedStartMinute Int?
  bookingSourceLabel String?
  bookingUrl String?
  confirmationReference String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)
  evidenceLinks ReservationEvidence[]
  @@index([tripId])
}
model ReservationEvidence {
  reservationId String
  evidenceRecordId String
  createdAt DateTime @default(now())
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  evidenceRecord EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  @@id([reservationId, evidenceRecordId])
  @@index([evidenceRecordId])
}

enum ReleasePrecision {
  UNKNOWN
  NOT_ANNOUNCED
  DATE_ONLY
  EXACT
  WINDOW
}
enum AvailabilityObservation {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
  LIMITED
}
enum EvidenceAttribution {
  OFFICIAL
  THIRD_PARTY
  USER_REPORTED
  DEVELOPMENT_FIXTURE
}
model ReleaseObservation {
  evidenceRecordId String @id
  availability AvailabilityObservation @default(UNKNOWN)
  precision ReleasePrecision
  releaseDate DateTime? @db.Date
  releaseAt DateTime? @db.Timestamptz(3)
  sourceTimeZone String?
  windowStartDate DateTime? @db.Date
  windowEndDate DateTime? @db.Date
  windowDescription String?
  observedAt DateTime @db.Timestamptz(3)
  recheckAfter DateTime? @db.Timestamptz(3)
  attribution EvidenceAttribution
  sourceUrl String?
  recordedByUser Boolean @default(true)
  evidenceRecord EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
}

enum TravelOriginKind {
  ENTERED
  EARLIER_ITEM
}
enum TravelTimeBasis {
  PLANNED
  CONFIRMED
}
enum TravelClockContext {
  SAME_LOCAL_CLOCK
  REQUIRES_REVIEW
}
model ItineraryTravelPlan {
  itemId           String @id
  tripId           String
  originKind       TravelOriginKind
  sourceItemId     String?
  originLabel      String
  travelMinutes    Int
  bufferMinutes    Int
  basis            TravelTimeBasis
  clockContext     TravelClockContext
  reviewedContext  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  trip             Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  target           ItineraryItem @relation("TravelTarget", fields: [itemId, tripId], references: [id, tripId], onDelete: Cascade)
  sourceItem       ItineraryItem? @relation("TravelOrigin", fields: [sourceItemId, tripId], references: [id, tripId], onDelete: NoAction)
  @@unique([itemId, tripId])
  @@index([sourceItemId, tripId])
  @@index([tripId])
}

// A narrow creation receipt makes retries safe even after item deletion.
model ManualActivitySubmission {
  id String @id
  tripId String
  itemId String? @unique
  requestHash String
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  item ItineraryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  @@index([tripId])
}

enum ResearchState {
  QUEUED
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
  CANCELLED
}
model ResearchJob {
  id String @id @default(cuid())
  tripId String
  segmentId String
  requestKey String
  context Json
  state ResearchState @default(QUEUED)
  approval String
  model String
  budgetUsd Float
  reservedUsd Float @default(0)
  searches Int @default(0)
  documents Int @default(0)
  extractions Int @default(0)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  actualInputTokens Int @default(0)
  actualOutputTokens Int @default(0)
  requestLog Json @default("[]")
  published Int @default(0)
  held Int @default(0)
  reason String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  deadline DateTime
  trip Trip @relation(fields:[tripId], references:[id], onDelete:Cascade)
  candidates ResearchCandidate[]
  @@index([state,createdAt])
  @@index([tripId,segmentId,requestKey])
}
model ResearchCandidate {
  id String @id @default(cuid())
  jobId String
  identity String
  payload Json
  reasons String[]
  publishedPlaceId String?
  job ResearchJob @relation(fields:[jobId],references:[id],onDelete:Cascade)
  @@unique([jobId,identity])
}
model ResearchPlace {
  placeId String @id
  identity String @unique
  originalName String
  kind String
  country String
  destinationId String
  sourceUrl String
  observedAt DateTime
  recheckAfter DateTime
  eventStart String?
  eventEnd String?
  eventTimeZone String?
  eventStatus String?
  eventPrecision String?
  media Json?
  withdrawn Boolean @default(false)
  place Place @relation(fields:[placeId],references:[id],onDelete:Cascade)
}

// No Trip foreign key: deleting a Trip must never refund already reserved spending.
model ResearchBudget {
  approval String @id
  reservedUsd Float @default(0)
}

// Fixed aggregate account, independent of Trips and approval labels. Integer micro-USD.
model ProviderPilotBudget {
  id String @id
  ceilingMicros Int
  googleLimitMicros Int
  googleReservedMicros Int @default(0)
  searches Int @default(0)
  details Int @default(0)
  photos Int @default(0)
  maxSearch Int
  maxDetails Int
  maxPhotos Int
}
// No provider payload, address, review, photo resource name or response cache.
model GoogleOperation {
  id String @id
  requestHash String
  purpose String
  approval String
  reservedMicros Int
  searches Int
  details Int
  photos Int
  state String @default("RESERVED")
  createdAt DateTime @default(now())
}
// Google policy permits place ID retention. Identity/content of Place remains app-owned.
model GooglePlaceReference {
  appPlaceId String @id
  googlePlaceId String
  identityHash String
  reviewedAt DateTime @default(now())
}
