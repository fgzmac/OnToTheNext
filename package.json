{
  "name": "onto-the-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/db-reset.ts",
    "postinstall": "prisma generate",
    "e2e": "playwright test",
    "research:worker": "tsx scripts/research-worker.ts",
    "research:evaluate": "tsx scripts/research-evaluate.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.2",
    "eslint": "9.28.0",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "@playwright/test": "1.63.0"
  }
}
